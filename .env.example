# ---------------------------------------------------------------------------
# MO-Insight local configuration
# Copy this file to .env and adjust paths/values for your machine.
# Nothing here is sent anywhere — it only configures local processes.
# ---------------------------------------------------------------------------

# --- LLM Provider switch ---
# "local"     (default) — Ollama, everything in the Ollama section below,
#                          fully offline, nothing ever leaves this machine.
# "anthropic" — Claude API. Needs ANTHROPIC_API_KEY below.
# "openai"    — ChatGPT / OpenAI API. Needs OPENAI_API_KEY below.
# "google"    — Gemini API. Needs GOOGLE_API_KEY below.
# "custom"    — any OTHER OpenAI-compatible API: Groq, Together, Fireworks,
#               DeepSeek, OpenRouter, a self-hosted vLLM/LM Studio server,
#               or any other "open source model, hosted behind an API key"
#               provider — nearly all of them speak the same API shape as
#               OpenAI. Needs CUSTOM_API_KEY + CUSTOM_BASE_URL + CUSTOM_MODEL
#               below.
#
# Every option other than "local" sends your questions and the retrieved
# evidence (client data, product info) to that provider's servers over the
# internet — this project's default has always been "local" for that
# reason. Switch back to "local" at any time; nothing else in the app needs
# to change either way, and none of the guardrails below change either —
# see the note at the end of this section.
LLM_PROVIDER=local

# --- Anthropic Claude API (only used when LLM_PROVIDER=anthropic) ---
# Get a key at https://console.anthropic.com/ (Settings -> API Keys).
ANTHROPIC_API_KEY=
# See https://docs.claude.com/en/docs/about-claude/models for current
# models/pricing — claude-opus-5 is the most capable and most expensive;
# claude-sonnet-5 is a cheaper, faster alternative for routine use.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=4096
# Max requests/minute this app will send to Anthropic — every extra request
# beyond one gets delayed just enough to stay under this, so a burst of the
# ~4 calls one question can trigger (follow-up rewrite, classification, SQL
# generation, final answer) doesn't blow through your plan's quota by
# itself. This is a GUESS at a typical free/trial-tier limit — check your
# actual limit at https://console.anthropic.com/settings/limits and set
# this to match (or a bit below, for safety margin). 0 disables the delay
# entirely (e.g. once you're on a paid tier with a much higher limit).
ANTHROPIC_RATE_LIMIT_RPM=5

# --- OpenAI / ChatGPT (only used when LLM_PROVIDER=openai) ---
# Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
# Same purpose as ANTHROPIC_RATE_LIMIT_RPM above — check your real limit at
# https://platform.openai.com/settings/organization/limits. 0 disables it.
OPENAI_RATE_LIMIT_RPM=3

# --- Google Gemini (only used when LLM_PROVIDER=google) ---
# Get a key at https://aistudio.google.com/apikey.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
GOOGLE_MAX_TOKENS=4096
# Google's free tier is commonly more generous than Anthropic's/OpenAI's for
# flash-tier models, but still check
# https://ai.google.dev/gemini-api/docs/rate-limits for your actual key.
# 0 disables it.
GOOGLE_RATE_LIMIT_RPM=15

# --- Any other OpenAI-compatible API (only used when LLM_PROVIDER=custom) ---
# Example (Groq): CUSTOM_BASE_URL=https://api.groq.com/openai/v1,
# CUSTOM_MODEL=llama-3.3-70b-versatile. Check your provider's docs for its
# exact base URL and model name.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_MAX_TOKENS=4096
# Free-tier limits on hosted open-weight providers vary a lot by provider
# and model — check your specific provider's docs/dashboard. 0 disables it
# (e.g. for a self-hosted server with no real rate limit).
CUSTOM_RATE_LIMIT_RPM=30

# NOTE ON GUARDRAILS: switching LLM_PROVIDER only changes which model
# answers — it never changes what the app asks it, or what it's allowed to
# do. The safety checks that actually matter (blocking vulgar language,
# refusing out-of-scope questions, and — most importantly — stopping a
# Business Associate from seeing another BA's or the firm's data) are all
# plain Python in backend/router.py that runs whether or not the model
# cooperates; they were never something a "helpful" or less-compliant model
# could talk its way around. Every prompt sent to the model (the SQL
# generation instructions, the column glossary, the answer-style rules) is
# passed byte-for-byte identical no matter which provider is configured.

# NOTE ON RATE LIMITS: the *_RATE_LIMIT_RPM settings above make this app
# pace its own requests to try to stay under your plan's limit, but they're
# a best-effort guess, not a guarantee — your real limit might be lower, or
# you might be running other things against the same key/quota. If a
# request still gets rate-limited despite the delay, the app does NOT crash
# or show a raw error — it returns a plain-language answer telling you the
# provider's limit was hit and to either wait a minute or switch
# LLM_PROVIDER back to "local" in the meantime. See router.py's
# _llm_unavailable_message / _looks_like_rate_limit_error.
#
# A single question can call the model up to ~4 times in a row (follow-up
# rewrite, intent classification, SQL generation [+ 1 retry if it
# hallucinates a column], final answer). Two things reduce that count:
# 1. Follow-up questions automatically fuse the rewrite + classification
#    into ONE call instead of two (see router.py's
#    contextualize_and_classify) — this happens by default, no setting.
# 2. SQL_RETRY_ATTEMPTS below controls the self-correction retry.
SQL_RETRY_ATTEMPTS=2

# --- Universal Local LLM Runtime (Ollama or any compatible local runner) ---
# Only used when LLM_PROVIDER=local (the default) above.
# To change models later: pull the new one, set OLLAMA_MODEL below to its
# exact Ollama tag, restart. Nothing else in this project needs to change —
# see the comment above OLLAMA_MODEL in backend/llm.py for the full list of
# what (little) is affected.
OLLAMA_BASE_URL=http://localhost:11434
# Pull it first: ollama pull qwen3.5:4b
OLLAMA_MODEL=qwen3.5:4b
# How much GPU VRAM (in GB) to plan around when auto-sizing the context
# window below. Defaults to 6 for a 6GB laptop GPU (e.g. an RTX 4050) — if
# you're on different hardware, change this and the context size below
# adjusts with it automatically, no manual math needed.
OLLAMA_GPU_VRAM_GB=6
# Context window (tokens) requested from Ollama. LEAVE THIS COMMENTED OUT
# (or blank) to let the app pick a size automatically from OLLAMA_MODEL's
# own parameter count + OLLAMA_GPU_VRAM_GB above — see
# backend/llm.py::_default_ollama_num_ctx for exactly how, and CLAUDE.md /
# the sizing table below for concrete examples. A bigger model's weights
# alone eat more VRAM, leaving less room for the context window's KV cache
# — on a VRAM-constrained GPU (e.g. a 6GB laptop card), pushing the context
# too high for a given model silently offloads layers to CPU and generation
# gets much slower with no error shown. Run `ollama ps` while a request is
# in flight to see the live CPU/GPU split for whatever's currently loaded —
# if it's not 100% GPU, either lower this or switch to a smaller model.
#
# Auto-sized examples at OLLAMA_GPU_VRAM_GB=6, OLLAMA_VRAM_RESERVE_PCT=15
# (uncomment OLLAMA_NUM_CTX below only if you want to override the
# automatic value):
#   qwen3.5:4b   (this project's default) -> 4096
#   llama3.2:3b  (or any ~3B model)       -> 4096
#   qwen3.5:9b   (or any ~9B model)       -> 1024 (very tight on 6GB — a
#                                            smaller model is the better fix
#                                            if 1024 feels too short)
# OLLAMA_NUM_CTX=4096
# Percentage of OLLAMA_GPU_VRAM_GB kept OUT of the sizing calculation above
# entirely — i.e. never counted as available for the model at all. This is
# what keeps the auto-sized context from planning as if the model gets the
# WHOLE GPU to itself: Windows' desktop compositor, an open browser with
# hardware acceleration, or anything else running at the same time all
# claim some VRAM too. Raise this if you regularly run other GPU-heavy
# things alongside the chatbot; lower it (down to 0) if this machine is
# dedicated to just this app and you want to reclaim that margin as context.
OLLAMA_VRAM_RESERVE_PCT=15
# How long Ollama keeps this model loaded in VRAM after the last request.
# Ollama's own default is 5m — on a VRAM-constrained card, reloading a model
# back in can itself take many seconds, which is easy to mistake for "the
# model is just slow" on the first question after a short pause. -1 means
# never unload it while Ollama is running (uses VRAM the whole time); lower
# it if you need that VRAM back for something else between uses.
OLLAMA_KEEP_ALIVE=30m
# Leave unset to let Ollama pick automatically. Only set this (to the number
# of layers to force onto GPU) if `ollama ps` shows a CPU/GPU split you know
# is wrong for your hardware — an incorrect value here can make things worse.
# OLLAMA_NUM_GPU=
# Reasoning-capable models (Qwen3/Qwen3.5, DeepSeek-R1, ...) can spend their
# whole output budget "thinking" in <think>...</think> before ever writing a
# real answer, which on a small OLLAMA_NUM_CTX can mean NO visible answer at
# all. This app wants direct, cited answers, so reasoning defaults off here.
# Set to "true" to allow it back on (slower, occasionally better for
# genuinely hard analytical questions), or "default" to defer to whatever the
# model itself would normally do.
OLLAMA_REASONING=false

# --- Structured Data Engine (DuckDB) ---
CSV_DATA_DIR=./data/csvs
DUCKDB_PATH=./local_warehouse.db

# --- Unstructured Data Engine (ChromaDB) ---
PDF_DATA_DIR=./data/pdfs
CHROMA_PATH=./chroma_db
EMBED_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- External API Integration Layer ---
NSE_API_BASE_URL=https://www.nseindia.com/api
EXTERNAL_API_TIMEOUT=5

# --- Server ---
HOST=0.0.0.0
PORT=8000
